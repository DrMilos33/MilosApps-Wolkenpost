{
  "name": "milosapps-wolkenpost",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4315 --strictPort",
    "build": "tsc -b && vite build",
    "build:dev-hosting": "tsc -b && vite build --mode github-pages",
    "preview": "vite preview --host 127.0.0.1 --port 4315 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:matrix": "playwright test tests/e2e/matrix.spec.ts",
    "test:all": "pnpm verify:shell && pnpm verify:layout && pnpm verify:essentials && pnpm test && pnpm build && pnpm test:e2e",
    "verify:shell": "node ./vendor/milosapps-shell/v2/verify.mjs --app-root . --manifest milos-app.json",
    "verify:layout": "node ./vendor/milosapps-layout/v1/verify-layout.mjs --app-root . --manifest milos-layout.json",
    "verify:essentials": "node ./vendor/milosapps-essentials/v1/verify.mjs --app-root . --manifest milos-essentials.json",
    "verify:dev-artifact": "node scripts/verify-dev-artifact.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.0",
    "@types/node": "24.0.0",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
